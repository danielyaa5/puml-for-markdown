{
  "name": "puml-for-markdown",
  "version": "2.2.0",
  "description": "Render PlantUML diagrams in GitHub Markdown: clickable diagram images and links from .puml files, with links between diagrams. CLI and GitHub Action.",
  "main": "index.js",
  "scripts": {
    "prepare": "husky install",
    "test": "node --test"
  },
  "author": {
    "name": "Daniel Yakobian",
    "url": "https://danielyakobian.com/"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "8.2.0",
    "ignore": "7.0.12",
    "markdown-it": "15.0.3",
    "plantuml-encoder": "1.4.0"
  },
  "bin": {
    "puml-for-markdown": "./bin/index.js"
  },
  "keywords": [
    "uml",
    "puml",
    "plantuml",
    "c4-plantuml",
    "c4",
    "diagrams",
    "git",
    "github",
    "md",
    "markdown",
    "generator",
    "cli",
    "github-action",
    "readme",
    "docs-as-code",
    "documentation",
    "architecture",
    "architecture-diagrams"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/danielyaa5/puml-for-markdown"
  },
  "devDependencies": {
    "husky": "7.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.js",
    "bin/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "lib/"
  ]
}
